#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
APP_PATH = File.expand_path("..", __dir__)

# The drain file is used to instruct the load balancer to stop sending traffic to this instance.
# This is used during deployments to ensure that the instance is not receiving traffic while it is being updated.
# DANBOORU_DRAIN_FILE overrides its location (containerized hosts keep drain state on a host mount).

DRAIN_FILE = ENV["DANBOORU_DRAIN_FILE"] || "#{APP_PATH}/tmp/out_of_rotation"

arg = ARGV[0]
unless %w[true false].include?(arg)
  puts "Usage: #{File.basename(__FILE__)} [true|false]"
  puts "Draining: #{File.exist?(DRAIN_FILE) ? 'true' : 'false'}"
  exit 1
end

if arg == "true"
  FileUtils.touch(DRAIN_FILE)
  puts "drain:true"
elsif arg == "false"
  FileUtils.rm_f(DRAIN_FILE)
  puts "drain:false"
end
