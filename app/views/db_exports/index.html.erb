<div id="c-db-exports">
  <div id="a-index">
    <h1>Database Exports</h1>

    <div class="exports-description">
      <p>Database exports in gzipped CSV format, updated daily.</p>
      <p>Each export lists a SHA-256 checksum of its <code>.csv.gz</code> file. After downloading, verify it with <code>sha256sum &lt;file&gt;</code>.</p>
      <p>For programmatic access, use the <%= link_to "JSON endpoint", db_exports_path(format: :json) %>.</p>
    </div>

    <% if @exports.any? %>
      <div class="exports-list">
        <div class="header">Name</div>
        <div class="header">Size</div>
        <div class="header">Updated</div>
        <div class="header">Checksum (SHA-256)</div>
        <div class="header"></div>

        <% @exports.each do |export| %>
          <div class="row">
            <div class="cell" data-label="Name">
              <% if export.columns.present? %>
                <details class="row-toggle">
                  <summary><%= svg_icon(:chevron_right, width: 12, height: 12, class: "row-toggle-icon") %> <strong><%= export.name %></strong></summary>
                </details>
              <% else %>
                <strong><%= export.name %></strong>
              <% end %>
            </div>
            <div class="cell" data-label="Size"><%= number_to_human_size(export.file_size) %></div>
            <div class="cell" data-label="Updated"><%= time_ago_in_words_tagged(export.updated_at) %></div>
            <div class="cell" data-label="Checksum">
              <% if export.checksum.present? %>
                <input type="text" class="export-checksum-input select-all" value="<%= export.checksum %>" readonly />
              <% else %>
                <span class="export-checksum-missing">&mdash;</span>
              <% end %>
            </div>
            <div class="cell" data-label="Actions">
              <%= link_to export.url, class: "export-download-link" do %>
                <%= svg_icon(:download, width: 16, height: 16) %> Download
              <% end %>
            </div>

            <% if export.columns.present? %>
              <div class="row-columns">
                <table class="export-columns-table">
                  <thead>
                    <tr>
                      <th>Column</th>
                      <th>Postgres type</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% export.columns.each do |column_name, column_type| %>
                      <tr>
                        <td><code><%= column_name %></code></td>
                        <td><code><%= column_type %></code></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p>No exports are currently available.</p>
    <% end %>
  </div>
</div>

<% content_for(:page_title) do %>
  Database Exports
<% end %>
