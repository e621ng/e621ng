<%= javascript_tag nonce: true do -%>
(function() {
  try {
    // Leave main/extra themes unset on the static homepage so the default is used.
    const isStaticHome = <%= controller_name == "static" && action_name == "home" ? "true" : "false" %>;
    // Keys and defaults: app/javascript/src/js/utility/storage/early_settings.json
    const settings = <%= raw early_settings_manifest.to_json %>;

    const b = document.body;
    for (const entry of settings) {
      if (isStaticHome && entry.skipOnStaticHome) continue;

      let value = localStorage.getItem(entry.key) ?? String(entry.default);
      if (entry.attr === "th-extra" && value === "spring" && Math.random() < 0.1)
        value = "fennec";

      b.setAttribute("data-" + entry.attr, value);
    }
  } catch(e) {}
})();
<% end -%>
