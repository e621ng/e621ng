<div id="c-pools">
  <div id="a-index">
    <%= render partial: "search", locals: { path: pools_path, ignore_for_display: %i[order] } %>
    <h2>Pools</h2>
    <div class="index-list pool-list">
      <nav class="index-list-header" aria-label="Sort pools">
        <span class="index-list-sort-by">Sort by</span>
        <%= pool_sort_link(:id, "ID", "pl-id") %>
        <%= pool_sort_link(:name, "Name", "pl-name") %>
        <%= pool_sort_link(:post_count, "Posts", "pl-posts") %>
        <%= pool_sort_link(:updated_at, "Updated", "pl-updated") %>
      </nav>

      <ul class="index-list-items">
        <% @pools.each do |pool| %>
          <%= tag.li(id: "pool-#{pool.id}", class: ["index-list-item", "pool-list-item", "pool-category-#{pool.category}"]) do %>
            <div class="pl-id index-list-muted index-list-number"><span class="index-list-label">#</span><%= pool.id %></div>
            <div class="pl-name">
              <%= link_to pool.pretty_name, pool_path(pool) %>

              <% if pool.last_page > 1 %>
                <%= link_to "page #{pool.last_page}", pool_path(pool, :page => pool.last_page), :class => "last-page" %>
              <% end %>
            </div>
            <div class="pl-posts index-list-number"><%= pool.post_count %><span class="index-list-label"> <%= "post".pluralize(pool.post_count) %></span></div>
            <div class="pl-updated index-list-muted index-list-number"><span class="index-list-label">Updated </span><%= compact_time(pool.updated_at) %></div>
          <% end %>
        <% end %>
      </ul>
    </div>

    <%= render PaginatorComponent.new(records: @pools) %>
  </div>
</div>

<%= render "secondary_links" %>

<% content_for(:page_title) do %>
  Pools
<% end %>

<% content_for(:html_header) do %>
  <meta name="description" content="Pools are groups of posts with something in common. The most common use of pools is for posts that are part of a series (such as a comic, or a group of images released by an artist).">
<% end %>
