<!-- Accessibility -->
<settings-group name="blacklisting">Blacklist</settings-group>

<settings-entry group="blacklisting" class="bigtext" search="posts blacklisted filtered tags blocked">
  <settings-head>Blacklisted Tags</settings-head>
  <settings-body>
    <%= form.input_field :blacklisted_tags, label: false, autocomplete: "tag-query", rows: 8 %>
  </settings-body>
  <settings-hint>
    Put any tag combinations you never want to see here. Each combination should go on a separate line. <a href='/help/blacklist'>View help.</a>
  </settings-hint>
</settings-entry>

<settings-entry group="blacklisting" class="inline" search="posts blacklisted filter users comments blips forum">
  <settings-head>Blacklist Users</settings-head>
  <settings-body>
    <%= form.input_field :blacklist_users, as: :boolean, class: "st-toggle" %>
    <%= form.label :blacklist_users, "!", class: "st-toggle", role: "switch" %>
  </settings-body>
  <settings-hint>
    Hide comments, blips and forum posts from users that have been blacklisted, in addition to posts.
  </settings-hint>
</settings-entry>
