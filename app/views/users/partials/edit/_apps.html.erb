<% if CurrentUser.user.is_logged_in? %>
<!-- Security -->
<settings-group name="security">Security</settings-group>

<settings-entry group="security" class="with-button" search="two factor authentication 2fa totp authenticator app security code backup">
  <% has_totp = CurrentUser.user.totp_enabled? %>
  <settings-head>Two-Factor Authentication</settings-head>
  <settings-body>
    <%= link_to "Manage 2FA", has_totp ? totp_path : new_totp_path, class: "st-button" %>
  </settings-body>
  <settings-hint>
    <% if has_totp %>
      Enabled — a code from your authenticator app is required to log in.
      <% if CurrentUser.user.totp&.backup_code_digests&.empty? %>
        You have no backup codes left; generate new ones.
      <% end %>
    <% else %>
      Require a code from an authenticator app when logging in.
    <% end %>
  </settings-hint>
</settings-entry>

<settings-entry group="security" class="with-button" search="active sessions logins devices browsers sign out everywhere revoke">
  <settings-head>Active Sessions</settings-head>
  <settings-body>
    <%= link_to "Manage Sessions", user_sessions_path, class: "st-button" %>
  </settings-body>
  <settings-hint>
    Browsers signed in to your account; sign any of them out.
  </settings-hint>
</settings-entry>
<% end %>

<% if CurrentUser.user.is_member? %>
<!-- API access -->
<settings-group name="access">API access</settings-group>

<settings-entry group="access" class="with-button" search="update change user profile account api key access">
  <settings-head>API Keys</settings-head>
  <settings-body>
    <%= link_to "Manage API Keys", api_keys_path, class: "st-button" %>
  </settings-body>
  <settings-hint>
    API access for automated processes.
  </settings-hint>
</settings-entry>

<% if Danbooru.config.enable_oauth_provider? %>
<settings-entry group="access" class="with-button" search="oauth openid connect connected applications clients authorized grants tokens permissions revoke">
  <settings-head>Connected Applications</settings-head>
  <settings-body>
    <%= link_to "Manage Connected Applications", oauth_authorized_applications_path, class: "st-button" %>
  </settings-body>
  <settings-hint>
    Third-party apps you have signed into.
  </settings-hint>
</settings-entry>
<% end %>
<% end %>


<% if Danbooru.config.enable_oauth_provider? && CurrentUser.user.can_manage_oauth_applications? %>
<!-- Developer -->
<settings-group name="developer">Developer</settings-group>

<settings-entry group="developer" class="with-button" search="oauth openid connect applications clients developer register">
  <settings-head>OAuth Applications</settings-head>
  <settings-body>
    <%= link_to "Manage OAuth Applications", mine_oauth_applications_path, class: "st-button" %>
  </settings-body>
  <settings-hint>
    Your applications that connect to the site.
  </settings-hint>
</settings-entry>
<% end %>
