<!-- Account -->
<settings-group name="account">Account</settings-group>

<% if CurrentUser.user.is_member? %>
<settings-entry group="account" class="with-buttons" search="update change user profile account name username">
  <settings-head>Username</settings-head>
  <settings-body>
    <input type="text" value="<%= CurrentUser.user.pretty_name %>" disabled><%= link_to "Edit", new_user_name_change_request_path, class: "st-button" %>
  </settings-body>
</settings-entry>
<% end %>

<settings-entry group="account" class="with-buttons" search="update change user profile account email e-mail address">
  <settings-head>Email</settings-head>
  <settings-body>
    <input type="text" value="<%= CurrentUser.user.email.presence || "blank" %>" disabled><%= link_to "Edit", new_maintenance_user_email_change_path, class: "st-button" %>
  </settings-body>
</settings-entry>


<settings-entry group="account" class="" id="settings-account-buttons" search="update change user profile account delete password">
  <settings-head></settings-head>
  <settings-body>
    <%= link_to "Change password", edit_user_password_path(user_id: @user.id), class: "st-button" %>
    <%= link_to "Delete account", maintenance_user_deletion_path, class: "st-button danger" %>
  </settings-body>
</settings-entry>

<settings-entry group="account" search="user account timezone">
  <settings-head>Time Zone</settings-head>
  <settings-body>
    <%= form.input_field :time_zone,
      label: false,
      include_blank: false
    %>
  </settings-body>
</settings-entry>


<!-- Notifications -->
<settings-group name="notifications">Notifications</settings-group>

<settings-entry group="notifications" class="inline" search="user account email notify notifications">
  <settings-head><%= form.label :receive_email_notifications, label: "Email Notifications" %></settings-head>
  <settings-body>
    <%= form.input_field :receive_email_notifications, as: :boolean, class: "st-toggle" %>
    <%= form.label :receive_email_notifications, "!", class: "st-toggle" %>
  </settings-body>
</settings-entry>

<settings-entry group="notifications" class="inline" search="user account forum activity dot bubble toggle notify notification">
  <settings-head><%= form.label :forum_notification_dot, label: "Forum Activity Dot" %></settings-head>
  <settings-body>
    <%= form.input_field :forum_notification_dot, as: :boolean, class: "st-toggle" %>
    <%= form.label :forum_notification_dot, "!", class: "st-toggle", role: "switch" %>
  </settings-body>
</settings-entry>


<!-- Profile -->
<% if CurrentUser.user.is_member? %>
<settings-group name="profile">Profile</settings-group>

<settings-entry group="profile" class="<%= @user.avatar_id.present? ? "with-buttons" : "" %>" search="update change user avatar profile image pfp crop">
  <settings-head><%= form.label :avatar_id, "Avatar Post ID" %></settings-head>
  <settings-body>
    <%= form.input_field :avatar_id, as: :string, label: false %>
    <% if @user.avatar_id.present? %>
      <%= link_to "Crop", edit_maintenance_user_avatar_path, class: "st-button" %>
    <% end %>
  </settings-body>
  <settings-hint>
    The image with this ID will be set as your avatar.
  </settings-hint>
</settings-entry>

<settings-entry group="profile" class="bigtext" search="user profile about me">
  <settings-head><%= form.label :profile_about, "About Me" %></settings-head>
  <settings-body>
    <%= form.input_field :profile_about,
      as: :dtext,
      label: false,
      rows: 8,
      limit: Danbooru.config.user_about_max_size,
      allow_color: true
    %>
  </settings-body>
</settings-entry>

<settings-entry group="profile" class="bigtext" search="user profile artist info">
  <settings-head><%= form.label :profile_artinfo, "Artist Info" %></settings-head>
  <settings-body>
    <%= form.input_field :profile_artinfo,
      as: :dtext,
      label: false,
      rows: 8,
      limit: Danbooru.config.user_about_max_size,
      allow_color: true
    %>
  </settings-body>
</settings-entry>
<% end %>


<!-- Posts -->
<settings-group name="posts">Posts</settings-group>

<settings-entry group="posts" search="default images width fit horizontal vertical sample large original display show scale posts">
  <settings-head><%= form.label :default_image_size, "Default image width" %></settings-head>
  <settings-body>
    <%= form.input_field :default_image_size,
      label: false,
      collection: [["Original", "original"], ["Fit (Horizontal)", "fit"], ["Fit (Vertical)", "fitv"], ["Sample (#{Danbooru.config.large_image_width}px)", "large"]],
      include_blank: false
    %>
  </settings-body>
  <settings-hint>
    Show original image size, scaled to fit, scaled to fit vertically, or show resized 850 pixel sample version.
  </settings-hint>
</settings-entry>

<settings-entry group="posts" search="posts number page display show">
  <settings-head><%= form.label :per_page, "Posts per page" %></settings-head>
  <settings-body>
    <%= form.input_field :per_page, label: false, as: :select, collection: (25..250).step(25), include_blank: false %>
  </settings-body>
</settings-entry>

<settings-entry group="posts" search="comments score rating upvotes downvotes display show hide">
  <settings-head><%= form.label :comment_threshold %></settings-head>
  <settings-body>
    <%= form.input_field :comment_threshold, label: false %>
  </settings-body>
  <settings-hint>
    Comments below this score will be hidden by default.
  </settings-hint>
</settings-entry>

<settings-entry group="posts" class="inline" search="posts comments show hide display hidden">
  <settings-head><%= form.label :hide_comments %></settings-head>
  <settings-body>
    <%= form.input_field :hide_comments, as: :boolean, class: "st-toggle" %>
    <%= form.label :hide_comments, "!", class: "st-toggle", role: "switch" %>
  </settings-body>
  <settings-hint>
    Do not show the comments section on post pages.
  </settings-hint>
</settings-entry>

<settings-entry group="posts" class="inline" search="posts comments show hide display own all your hidden">
  <settings-head><%= form.label :show_hidden_comments, "Show #{CurrentUser.user.is_staff? ? 'all' : 'your'} hidden comments" %></settings-head>
  <settings-body>
    <%= form.input_field :show_hidden_comments, as: :boolean, class: "st-toggle" %>
    <%= form.label :show_hidden_comments, "!", class: "st-toggle", role: "switch" %>
  </settings-body>
  <settings-hint>
    Show <%= CurrentUser.user.is_staff? ? "all" : "your" %> hidden comments on comment pages.
  </settings-hint>
</settings-entry>

<settings-entry group="posts" class="inline" search="posts display show hide mode explicit questionable safe rated rating">
  <settings-head><%= form.label :enable_safe_mode, "Safe mode" %></settings-head>
  <settings-body>
    <%= form.input_field :enable_safe_mode, as: :boolean, class: "st-toggle" %>
    <%= form.label :enable_safe_mode, "!", class: "st-toggle", role: "switch" %>
  </settings-body>
  <settings-hint>
    Only show images rated safe.
  </settings-hint>
</settings-entry>
