<% active_section = active_settings_section(params[:tab]) %>
<div id="c-users"><div id="a-edit">
  <div class="settings-layout">
    <div class="settings-sidebar"><nav class="settings-nav" aria-label="Settings sections">
      <section class="settings-nav-search">
        <h1><label for="settings-find">Settings</label></h1>
        <input type="search" id="settings-find" name="find" value="<%= params[:find] %>" placeholder="Search settings">
      </section>

      <ul class="settings-nav-list">
        <% settings_sections.each do |section| %>
          <li><%= link_to section.label, "?tab=#{section.key}", data: { section: section.key }, aria: { current: section == active_section ? "true" : nil } %></li>
        <% end %>
      </ul>

      <form class="settings-nav-select" method="get" action="<%= request.path %>">
        <select name="tab" aria-label="Settings section">
          <%= options_for_select(settings_sections.map { |section| [section.label, section.key] }, active_section.key) %>
        </select>
        <noscript><button type="submit" class="st-button">Go</button></noscript>
      </form>
    </nav></div>

    <%= custom_form_for @user, html: { class: "settings-content" } do |form| %>
      <% settings_sections.each do |section| %>
        <section class="settings-section" id="settings-<%= section.key %>" data-section="<%= section.key %>" <%= "hidden" unless section == active_section %>>
          <%= render "users/partials/edit/#{section.key}", form: form %>
        </section>
      <% end %>
      <p class="settings-no-results" hidden>No settings found.</p>
      <settings-submit>
        <%= form.button :submit, "Save Settings" %>
      </settings-submit>
    <% end %>
  </div>
</div></div>

<% content_for(:page_title) do %>
  Settings
<% end %>

<%= render "secondary_links" %>
