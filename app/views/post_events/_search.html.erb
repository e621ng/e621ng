<%= form_search path: post_events_path do |f| %>
  <%= f.input :post_id, label: "Post #" %>
  <%= f.user :creator %>

  <%= f.input :action,
              collection: (
                            PostEvent.search_options_for(CurrentUser.user).map do |key|
                              [
                                key.to_s.capitalize.tr("_", " "),
                                key.to_s,
                                { data: { fields: PostEvent.searchable_fields_for(key, CurrentUser.user).keys.join(",") } }
                              ]
                            end
                          ),
              include_blank: "Any" %>
<% end %>
