<%= custom_form_for(@saved_search) do |f| %>
  <%= error_messages_for :saved_search %>
  <%= f.input :query, as: :string, hint: "A post search. Wildcard tags (e.g. tag_*) and search: references are not allowed." %>

  <%= f.input :name, as: :string, hint: "Optional. Can only contain letters, numbers, and underscores and must contain at least one
      letter or underscore. Lets you reference this search as search:example in post searches." %>

  <%= f.input :is_tracked, label: "Track new posts", hint: "Show a badge with the number of new posts matching this search since you last viewed it." %>

  <%= f.button :submit, "Submit" %>
<% end %>
