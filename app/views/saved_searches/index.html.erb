<div id="c-saved-searches">
  <div id="a-index">
    <div class="saved-search-header">
      <h2>Saved Searches</h2>
      <div class="saved-search-controls">
        <%= link_to "New saved search", new_saved_search_path, class: "button btn-success" %>
        <% if CurrentUser.user.has_tracked_saved_searches %>
          <%= button_to "Mark all as seen", mark_all_seen_saved_searches_path, method: :post, class: "button btn-neutral" %>
        <% end %>
      </div>
    </div>

    <% if @saved_searches.empty? %>
      <p>You have no saved searches. Save one from the posts page, or create one here.</p>
    <% else %>
      <ul class="saved-search-list">
        <% @saved_searches.each do |ss| %>
          <li class="saved-search-item" id="saved-search-<%= ss.id %>">
            <div class="ss-name">
              <% if ss.name.present? %>
                <%= ss.name %>
              <% else %>
                <span class="ss-muted">Unnamed</span>
              <% end %>
            </div>
            <div class="ss-query"><%= link_to ss.query, visit_saved_search_path(ss), title: ss.query %></div>
            <div class="ss-status">
              <% if ss.is_tracked? %>
                <%= svg_icon(:bell, width: 16, height: 16) %>
                <% count = @counts[ss.id] %>
                <% if count.nil? %>
                  <span class="ss-muted" title="This search could not be evaluated. Try editing it.">Unavailable</span>
                <% elsif count > 0 %>
                  <span class="saved-search-new-count"><%= count >= SavedSearch::BADGE_COUNT_CAP ? "#{SavedSearch::BADGE_COUNT_CAP - 1}+" : count %> new</span>
                <% else %>
                  <span>Tracked</span>
                <% end %>
              <% end %>
            </div>
            <div class="ss-created"><%= time_ago_in_words_tagged ss.created_at, compact: true %></div>
            <div class="ss-actions">
              <%= link_to "Edit", edit_saved_search_path(ss) %>
              <%= link_to "Delete", saved_search_path(ss), data: { confirm: "Are you sure you want to delete this saved search?" }, method: :delete %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<% content_for(:page_title) do %>
  Saved Searches
<% end %>
