<div id="c-tags">
  <div id="a-edit">
    <h1>Tag: <%= link_to @tag.name, posts_path(:tags => @tag.name), :class => "tag-type-#{@tag.category}" %></h1>

    <%= render "edit_form", tag: @tag, from_wiki: @from_wiki %>
  </div>
</div>

<%= render "secondary_links" %>

<% content_for(:page_title) do %>
  Edit Tag - <%= @tag.name %>
<% end %>
