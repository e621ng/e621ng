<div>
  <h1>Remove Two-Factor Authentication</h1>
  <p>
    This removes two-factor authentication from <strong><%= @user.name %></strong>'s account,
    logs out all of their sessions, and notifies them by email.
    The action is publicly logged.
  </p>
  <p>Only do this after verifying the account owner's identity.</p>
  <%= custom_form_for(:admin, url: totp_reset_staff_user_path(@user)) do |f| %>
    <%= f.button :submit, "Remove 2FA" %>
  <% end %>
</div>

<% content_for(:page_title) do %>
  Remove 2FA - <%= @user.name %>
<% end %>
