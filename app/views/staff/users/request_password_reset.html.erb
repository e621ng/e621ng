<div>
  <h1>Reset Password</h1>
  <%= custom_form_for(:admin, url: password_reset_staff_user_path(@user)) do |f| %>
    <p>
      <% if @user.email.blank? %>
        Create a password reset request for <strong><%= @user.name %></strong>.<br />
        <b>Note</b>: This user has no email address associated with their account.
      <% else %>
        Send a password reset email to <strong><%= @user.name %></strong> (<%= @user.email %>).
      <% end %>
    </p>
    <%= f.input :invalidate_old_password, as: :boolean, label: "Invalidate the users current password", hint: "This will log the user out and prevent them from logging in with their old password" %>
    <%= f.button :submit, "Reset", class: "st-button submit" %>
  <% end %>
</div>

<% if @user.totp_enabled? %>
  <div>
    <h1>Remove 2FA</h1>
    <%= custom_form_for(:admin, url: totp_reset_staff_user_path(@user)) do |f| %>
      <p>
        Remove 2FA for <strong><%= @user.name %></strong> and log them out of all sessions.<br />
        This will allow them to log in with their username and password only.
      </p>
      <%= f.button :submit, "Remove 2FA", class: "st-button submit" %>
    <% end %>
  </div>
<% end %>

<%= render "/users/secondary_links" %>

<% content_for(:page_title) do %>
  Reset Password - <%= @user.name %>
<% end %>
