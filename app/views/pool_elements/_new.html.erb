<%= form_tag(pool_element_path, class: "simple_form", id: "add-to-pool-dialog", data: { title: "Add to Pool", width: "250" }) do %>
  <%# Only used by the no-JS fallback; the dialog reads the post id from CurrentPost %>
  <%= hidden_field_tag "post_id", @post.id %>

  <div class="input dialog-inputs">
    <label for="pool_name">Pool Name</label>
    <%= text_field_tag "pool_name", "", data: { autocomplete: "pool" } %>
    <span class="hint">Enter the pool's name (<%= link_to "see full list", gallery_pools_path %>)</span>
  </div>

  <div class="dialog-recent" hidden>
    <b>Recent Pools</b>
    <ul id="recent-pools"></ul>
  </div>

  <div class="input dialog-submit">
    <button type="button" class="st-button" name="cancel">Cancel</button>
    <button type="submit" class="st-button submit">Submit</button>
  </div>
<% end %>
