<div id="c-forums">
  <div id="a-show">
    <div class="forum-heading">
      <div class="forum-heading-text">
        <p class="forum-breadcrumb"><%= link_to "Forum", forums_path %> ›</p>
      </div>
      <div class="forum-heading-tools">
        <% if CurrentUser.is_member? && @category.can_create? %>
          <%= link_to new_forum_topic_path(forum_topic: { category_id: @category.id }), class: "st-button submit forum-new-topic" do %>
            <%= svg_icon(:plus, width: 16, height: 16) %> New topic
          <% end %>
        <% end %>
      </div>
    </div>

    <section class="forum-category" data-category-id="<%= @category.id %>">
      <%= render "category_header", category: @category, link: false, heading: :h1 %>
      <%= render ForumTopicRowComponent.with_collection(@stickies, pinned: true) %>
      <%= render ForumTopicRowComponent.with_collection(@forum_topics) %>
      <% if @stickies.empty? && @forum_topics.empty? %>
        <p class="forum-category-empty">No topics yet.</p>
      <% end %>
    </section>

    <%= render PaginatorComponent.new(records: @forum_topics) %>
  </div>
</div>

<%= render "forum_topics/secondary_links" %>

<% content_for(:page_title) do %>
  Forum - <%= @category.name %>
<% end %>
