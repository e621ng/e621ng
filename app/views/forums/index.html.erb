<div id="c-forums">
  <div id="a-index">
    <div class="forum-heading">
      <div class="forum-heading-text">
        <h1>Forum</h1>
      </div>
      <div class="forum-heading-tools">
        <% if CurrentUser.is_member? %>
          <%= button_to "Mark all as read", mark_all_as_read_forum_topics_path, class: "st-button kinetic", form: { data: { confirm: "Are you sure that you want to mark all forum topics as read?" } } %>
          <%= link_to new_forum_topic_path, class: "st-button kinetic submit forum-new-topic" do %>
            <%= svg_icon(:plus, width: 16, height: 16) %> New topic
          <% end %>
        <% end %>
      </div>
    </div>

    <% @categories.each do |category| %>
      <% stickies = @stickies.fetch(category.id, []) %>
      <% topics = @topics.fetch(category.id, []) %>
      <section class="forum-category" data-category-id="<%= category.id %>">
        <%= render "category_header", category: category, link: true %>

        <% if CurrentUser.user.is_member? && category.id == Danbooru.config.alias_implication_forum_category %>
          <%= render "aibur_actions" %>
        <% end %>

        <%= render ForumTopicRowComponent.with_collection(stickies, pinned: true) %>
        <%= render ForumTopicRowComponent.with_collection(topics) %>
        <% if category.landing_topic_count > 0 && stickies.empty? && topics.empty? %>
          <p class="forum-category-empty">No topics yet.</p>
        <% end %>
      </section>
    <% end %>
  </div>
</div>

<%= render "forum_topics/secondary_links" %>

<% content_for(:page_title) do %>
  Forum
<% end %>
