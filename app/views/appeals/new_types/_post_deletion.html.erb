<% @deletion = @appeal.content %>

<h4 class="appeal-flag-title">You are appealing the following deletion:</h4>
<div class="appeal-flag-info">
  [DELETION]
  <%= format_text(@deletion.reason || "Unknown reason", inline: true) %>
  - <%= link_to_user(@deletion.deleter) %>
  - <%= time_ago_in_words_tagged(@deletion.created_at) %>
</div>

<div class="appeal-flag-post">
  <%= render(PostThumbnailComponent.new(post: @deletion.post, stats: true, show_deleted: true, no_blacklist: true)) %>
</div>
