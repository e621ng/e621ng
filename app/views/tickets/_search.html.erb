<%= form_search path: tickets_path do |f| %>
  <% if CurrentUser.is_staff? %>
    <%= f.user :creator, label: "Reporter" %>
    <%= f.user :accused %>
    <%= f.user :claimant %>
    <%= f.input :reason %>
  <% end %>
  <%= f.input :qtype, label: "Type", collection: [
      ["User complaint", "user"],
      ["Private message complaint", "dmail"],
      ["Comment complaint", "comment"],
      ["Forum post complaint", "forum"],
      ["Blip complaint", "blip"],
      ["Wiki complaint", "wiki"],
      ["Pool complaint", "pool"],
      ["Set complaint", "set"],
      ["Post complaint", "post"],
      ["Replacement complaint", "replacement"]
  ], include_blank: "Any" %>
  <%= f.input :status, as: :grouped_select, collection: {
    "Pending" => [
      %w[Pending pending],
      ["Pending + Unclaimed", "pending_unclaimed"],
      ["Pending + Claimed", "pending_claimed"],
      ["Under investigation", "partial"],
    ],
    "Handled" => [
      %w[Investigated approved],
    ],
  }.to_a, group_label_method: :first, group_method: :last, include_blank: "Any" %>
<% end %>
