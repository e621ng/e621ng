<%# local: content %>
<% created_at = content.created_at %>
<span class="ticket-display-age <%= created_at > 6.months.ago ? "text-green" : "text-red" %>">
  <time datetime="<%= created_at.iso8601 %>" title="<%= created_at.strftime("%B %d, %Y %H:%M:%S") %>"><%= time_ago_in_words(created_at) %> ago</time>
</span>
