<div id="c-tickets"><div id="a-show">

  <div class="ticket-display">
    <div class="section ticket-display-header">
      <h3><%= @ticket.type_title %> Ticket</h3>
    </div>

    <%= render "tickets/partials/reported_content" %>

    <div class="ticket-display-report">
      <div class="ticket-display-report-avatar">
        <% if @ticket.creator.present? %>
          <%= render AvatarComponent.new(user: @ticket.creator) %>
        <% else %>
          <div class="ticket-display-avatar-placeholder"></div>
        <% end %>
      </div>

      <div class="ticket-display-report-creator">
        <%= @ticket.creator.present? ? link_to_user(@ticket.creator) : "a user" %>
        reported
        <%= time_ago_in_words_tagged(@ticket.created_at) %>

        <% if CurrentUser.is_admin? %>
          <div class="ticket-display-report-ip">
            <%= link_to_ip(@ticket.creator_ip_addr) %>
          </div>
        <% end %>
      </div>

      <div class="ticket-display-section ticket-display-report-reason dtext-container">
        <% if @ticket.qtype == "post" && @ticket.post_report_reason.present? %>
          <div class="ticket-display-report-reason-label"><%= @ticket.post_report_reason.reason %></div>
        <% end %>
        <%= format_text(@ticket.reason) %>
      </div>
    </div>

    <% if CurrentUser.user.is_staff? %>
      <% open_from_same_user = @ticket.open_from_same_user %>
      <% if open_from_same_user.any? %>
        <div class="ticket-display-section ticket-display-others">
          <b><%= link_to_user(@ticket.creator) %>'s other open tickets:</b>
          <ul>
            <% open_from_same_user.each do |other| %>
              <li>
                <%= link_to "#{other.id}: #{other.subject}", ticket_path(other.id) %>
                <% if other.status != "pending" %>
                  (<%= pretty_ticket_status(other) %>)
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% all_for_same_content = @ticket.all_for_same_content %>
      <% if all_for_same_content.any? %>
        <div class="ticket-display-section ticket-display-others">
          <b>Other tickets for this <%= @ticket.type_title.downcase %>:</b>
          <ul>
            <% all_for_same_content.each do |other| %>
              <li>
                <%= link_to "#{other.id}: #{other.subject}", ticket_path(other.id) %>
                <% if other.creator_id != @ticket.creator_id %>
                  by <%= link_to_user(other.creator) %>
                <% end %>
                <% if other.status != "pending" %>
                  (<%= pretty_ticket_status(other) %>)
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>

    <div class="ticket-display-section ticket-display-info">
      <div class="ticket-display-info-entry">
        <b>Status:</b>
        <span class="<%= @ticket.status %>-ticket"><%= pretty_ticket_status(@ticket) %></span>
      </div>

      <% if @ticket.accused.present? %>
        <div class="ticket-display-info-entry">
          <b>Accused:</b>
          <%= link_to_user @ticket.accused %>
          <% if CurrentUser.user.is_staff? && (pending_accused_count = Ticket.active.for_accused(@ticket.accused.id).count) >= 2 %>
            (<%= link_to "#{pending_accused_count} Pending", tickets_path(search: { accused_id: @ticket.accused.id, status: "pending" }) %>)
          <% end %>
        </div>
      <% end %>

      <% if CurrentUser.user.is_staff? && !@ticket.approved? %>
        <div class="ticket-display-info-entry">
          <b>Claimed By:</b>
          <span>
            <% if @ticket.claimant.present? %>
              <%= link_to_user @ticket.claimant %>
            <% else %>
              none
            <% end %>
          </span>
        </div>
      <% end %>
    </div>

    <% if CurrentUser.user.is_staff? && @ticket.can_claim?(CurrentUser.user) && !@ticket.approved? %>
      <div class="ticket-display-claim">
        <% if @ticket.claimant.nil? %>
          <%= link_to "Claim", claim_ticket_path(@ticket), method: :post, class: "st-button kinetic" %>
        <% elsif @ticket.claimant.id == CurrentUser.id %>
          <%= link_to "Unclaim", unclaim_ticket_path(@ticket), method: :post, class: "st-button kinetic" %>
        <% end %>
      </div>
    <% end %>

    <% if @ticket.response.present? %>
      <% handler = @ticket.handler || @ticket.claimant %>
      <div class="ticket-display-report">
        <div class="ticket-display-report-avatar">
          <% if handler.present? %>
            <%= render AvatarComponent.new(user: handler) %>
          <% else %>
            <div class="ticket-display-avatar-placeholder"></div>
          <% end %>
        </div>

        <div class="ticket-display-report-creator">
          <%= handler.present? ? link_to_user(handler) : "a staff member" %>
          responded
          <%= time_ago_in_words_tagged(@ticket.updated_at) %>
        </div>

        <div class="ticket-display-section ticket-display-report-reason dtext-container">
          <%= format_text(@ticket.response) %>
        </div>
      </div>
    <% end %>
  </div>

  <% if CurrentUser.is_staff? && @ticket.can_handle? %>
    <%= custom_form_for(@ticket, html: { class: "ticket-display-response" }) do |f| %>
      <%= f.input :status, collection: [["Investigated", "approved"], ["Under Investigation", "partial"]], selected: @ticket.status || "approved" %>
      <% if @ticket.warnable? %>
        <%= f.input :record_type, label: "Mark the #{@ticket.content.model_name.singular.humanize(capitalize: false)} as having received", collection: @ticket.content.class.warning_types.to_h { |k, v| ["A #{k}", v] }, include_blank: "Nothing" %>
      <% end %>
      <% unless @ticket.pending? %>
        <%= f.input :send_update_dmail, label: "Send update DMail", as: :boolean, hint: "A DMail is always sent if the status is changed" %>
      <% end %>

      <%= f.input :response, as: :dtext, limit: Danbooru.config.dmail_max_size, allow_color: false %>

      <%= tag.input name: "force_claim", type: "hidden", value: params[:force_claim] %>
      <%= f.button :submit, "Submit" %>
    <% end %>
  <% end %>
</div></div>

<% content_for(:title) do %>
  <%= @ticket.type_title %>
<% end %>

<%= render partial: "secondary_links" %>

<% content_for(:page_title) do %>
  <%= @ticket.type_title %> Ticket
<% end %>
