<% if (post = @ticket.content) %>
  <% component = PostThumbnailComponent.new(post: post, stats: true, show_deleted: true, no_blacklist: true) %>
  <% if component.render? %>
    <div class="ticket-display-section ticket-display-post">
      <%= render(component) %>
    </div>
  <% else %>
    <div class="ticket-display-section"><%= link_to "Post ##{post.id}", post_path(post) %></div>
  <% end %>
<% else %>
  <div class="ticket-display-section">
    <span class="text-error"><%= link_to "Post ##{@ticket.disp_id}", post_path(id: @ticket.disp_id) %> not found</span>
  </div>
<% end %>
