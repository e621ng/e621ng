<% if (comment = @ticket.content) %>
  <div class="ticket-display-section ticket-display-content-header">
    <%= link_to "Comment ##{comment.id}", comment_path(comment) %>
    on <%= link_to "post ##{comment.post_id}", post_path(comment.post_id) %>
    by <%= link_to_user comment.creator %>,
    <%= render "tickets/partials/content_age", content: comment %>
    <% if comment.is_hidden? %><span class="ticket-display-marker">hidden</span><% end %>
  </div>
  <% if comment.is_accessible?(CurrentUser.user, bypass_user_settings: true) %>
    <div class="ticket-display-section ticket-display-content-body dtext-container">
      <%= format_text(comment.body) %>
    </div>
  <% end %>
<% else %>
  <div class="ticket-display-section"><span class="text-error">Comment has been deleted</span></div>
<% end %>
