<% if (dmail = @ticket.content) %>
  <div class="ticket-display-section ticket-display-content-header">
    <%= link_to dmail.title, dmail_path(dmail) %>
    from <%= link_to_user dmail.from %>
    to <%= link_to_user dmail.to %>,
    <%= render "tickets/partials/content_age", content: dmail %>
    <% if dmail.is_deleted? %><span class="ticket-display-marker">deleted</span><% end %>
  </div>
  <% if dmail.visible_to?(CurrentUser.user) %>
    <div class="ticket-display-section ticket-display-content-body dtext-container">
      <%= format_text(dmail.body) %>
    </div>
  <% end %>
<% else %>
  <div class="ticket-display-section"><span class="text-error">Message has been deleted</span></div>
<% end %>
