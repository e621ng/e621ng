<%# locals: (tag:) %>
<% if tag.present? && CurrentUser.user.is_member? %>
  <% subscription = CurrentUser.user.tag_subscriptions.find_by(tag_id: tag.id) %>
  <% if subscription %>
    <%= link_to "Unsubscribe", tag_subscription_path(subscription), method: :delete, id: "tag-subscription-toggle", class: "button btn-neutral",
                title: "Stop counting new posts with this tag in your subscriptions", data: { tag: tag.name, subscribed: "true" } %>
  <% else %>
    <%= link_to "Subscribe", tag_subscriptions_path(tag_name: tag.name), method: :post, id: "tag-subscription-toggle", class: "button btn-success",
                title: "Count new posts with this tag in your subscriptions", data: { tag: tag.name, subscribed: "false" } %>
  <% end %>
<% end %>
