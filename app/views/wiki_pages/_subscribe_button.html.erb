<%# locals: (tag:, subscription: :lookup) %>
<%# Pass a preloaded `subscription` (or nil) for tags known not to be aliased, to skip the lookups %>
<% if tag.present? && CurrentUser.user.is_member? %>
  <% if subscription == :lookup %>
    <%# Subscribing follows aliases, so the state must be read from the same tag %>
    <% target_name = TagAlias.to_aliased([tag.name]).first %>
    <% target = target_name == tag.name ? tag : Tag.find_by(name: target_name) %>
    <% subscription = target && CurrentUser.user.tag_subscriptions.find_by(tag_id: target.id) %>
  <% else %>
    <% target = tag %>
  <% end %>
  <% if target %>
    <% aliased_note = target == tag ? "" : " (#{tag.name} is aliased to #{target.name})" %>
    <% if subscription %>
      <%= link_to "Unsubscribe", tag_subscription_path(subscription), method: :delete, class: "button btn-neutral tag-subscription-toggle",
                  title: "Stop counting new posts with this tag in your subscriptions#{aliased_note}", data: { tag: tag.name, subscribed: "true" } %>
    <% else %>
      <%= link_to "Subscribe", tag_subscriptions_path(tag_name: tag.name), method: :post, class: "button btn-success tag-subscription-toggle",
                  title: "Count new posts with this tag in your subscriptions#{aliased_note}", data: { tag: tag.name, subscribed: "false" } %>
    <% end %>
  <% end %>
<% end %>
