<%= form_search(path: forum_posts_path) do |f| %>
  <%= f.input(:topic_title_matches, label: "Topic Title") %>
  <%= f.input(:body_matches, label: "Body") %>
  <%= f.user(:creator, label: "Author") %>
  <%= f.input(:topic_category_id, label: "Topic Category", collection: ForumCategory.visible.reverse_mapping, include_blank: "Any") %>
  <%= f.input(:order, collection: [%w[Newest id_desc], %w[Oldest created_at_asc], %w[Updated updated_at]]) %>
<% end %>
