<div id="c-post-replacements">
  <div id="a-index">
    <h1>Post Replacements</h1>

    <%= render "search" %>
    <%= render partial: "application/blacklist_inline" %>

    <div class="<%= @timeline ? "replacement-timeline" : "replacement-list" %>">
      <%= render(PostReplacementCardComponent.with_collection(@post_replacements, timeline: @timeline)) %>
    </div>

    <%= render PaginatorComponent.new(records: @post_replacements) %>
  </div>
</div>

<% content_for(:page_title) do %>
  Post Replacements
<% end %>

<%= render "secondary_links" %>
