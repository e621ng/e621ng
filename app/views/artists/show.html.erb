<%= render layout: "show" do %>
  <div>
    <% if @artist.new_record? %>
      <p>This artist entry does not exist. <%= link_to "Create new artist entry", new_artist_path(artist: { name: @artist.name }) %>.</p>
    <% else %>
      <%= render "summary", artist: @artist %>
    <% end %>
  </div>
<% end %>

<% if @artist.new_record? %>
  <% content_for(:html_header) do %>
    <meta name="robots" content="noindex" />
  <% end %>
<% else %>
  <% render(partial: "static/embed", locals: { record: @artist, name: @artist.pretty_name, description: @artist.notes.present? ? format_plaintext(@artist.notes) : "" }) %>
<% end %>
