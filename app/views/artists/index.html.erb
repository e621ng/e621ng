<div id="c-artists">
  <div id="a-index">
    <%= render "search" %>
    <table class="striped">
      <thead>
        <tr>
          <th width="50%">Primary Name</th>
          <th width="50%">Secondary Names</th>
        </tr>
      </thead>
      <tbody>
        <% @artists.each do |artist| %>
          <%= tag.tr(id: "artist-#{artist.id}") do %>
            <td>
              <%= link_to h(artist.name), short_artist_path(artist.name) %>
              <% if !artist.group_name.blank? %>
                (group: <%= link_to(artist.group_name, short_artist_path(artist.name)) %>)
              <% end %>
            </td>
            <td><%= artist.other_names_string %></td>
          <% end %>
        <% end %>
      </tbody>
    </table>

    <%= render PaginatorComponent.new(records: @artists) %>
  </div>
</div>

<%= render "secondary_links" %>

<% content_for(:page_title) do %>
  Artists
<% end %>
