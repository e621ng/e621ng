<form class="simple_form" id="add-to-set-dialog" data-title="Add to Set" data-width="250">
  <div class="input dialog-inputs">
    <label for="add-to-set-id">Set Name</label>
    <select id="add-to-set-id">
      <option>Loading...</option>
    </select>
    <span class="hint">Create a new set <%= link_to "here", new_post_set_path %>.</span>
  </div>

  <div class="input dialog-submit">
    <button type="button" class="st-button" name="cancel">Cancel</button>
    <button type="submit" class="st-button submit">Submit</button>
  </div>
</form>
