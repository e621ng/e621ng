<mj-section mj-class="container hex-bg">
  <mj-column>

    <mj-text mj-class="text">
      <h2>Hi, <%= @user.name %>!</h2>
      <p>
        Two-factor authentication was just <strong>enabled</strong> on your <%= Danbooru.config.app_name %> account.
        From now on, logging in requires a code from your authenticator app.
      </p>
      <p>
        All other sessions have been logged out.
      </p>
      <p>
        If you did not do this, your account may be compromised — reset your password immediately and contact staff.
      </p>
    </mj-text>

  </mj-column>
</mj-section>
