<%# locals: (post:) %>
<% tags = post.subscribable_artist_tags.first(Post::SUBSCRIBE_BANNER_LIMIT) %>
<% subscriptions = CurrentUser.user.tag_subscriptions.where(tag_id: tags.map(&:id)).index_by(&:tag_id) %>
<% subscriber_counts = TagSubscription.subscriber_counts(tags.map(&:id)) %>
<div id="post-artist-subscribe">
  <% tags.each do |tag| %>
    <% subscription = subscriptions[tag.id] %>
    <% subscriber_count = subscriber_counts[tag.id] %>
    <div class="subscribe-banner">
      <div class="subscribe-banner-count">
        <%= content_tag :span, "#{TagSetPresenter.post_count_label(subscriber_count)} #{'subscriber'.pluralize(subscriber_count)}",
                        class: "tag-subscriber-count", title: "#{number_with_delimiter(subscriber_count)} #{'subscriber'.pluralize(subscriber_count)}",
                        data: { count: subscriber_count, tag: tag.name } %>
      </div>
      <div class="subscribe-banner-name">
        <%= link_to short_artist_path(tag.name), class: "tag-type-#{tag.category}" do %>
          <%= tag.name %>
          <% if post.uploader_linked_artists.include?(tag.name) %>
            <%= svg_icon(:chexagon, class: "chexagon", title: "Uploaded by the artist") %>
          <% end %>
        <% end %>
      </div>
      <div class="subscribe-banner-actions">
        <% if subscription %>
          <%= link_to "Unsubscribe", tag_subscription_path(subscription), method: :delete, class: "button btn-neutral tag-subscription-toggle",
                      title: "Stop counting new posts with this tag in your subscriptions", data: { tag: tag.name, subscribed: "true" } %>
        <% else %>
          <%= link_to "Subscribe", tag_subscriptions_path(tag_name: tag.name), method: :post, class: "button btn-success tag-subscription-toggle",
                      title: "Count new posts with this tag in your subscriptions", data: { tag: tag.name, subscribed: "false" } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
