<%# locals: (post:) %>
<% tags = post.verified_artist_tags.first(Post::SUBSCRIBE_BANNER_LIMIT) %>
<% subscriptions = CurrentUser.user.tag_subscriptions.where(tag_id: tags.map(&:id)).index_by(&:tag_id) %>
<div id="post-artist-subscribe">
  <% tags.each do |tag| %>
    <div class="subscribe-banner">
      <div class="subscribe-banner-name">
        <%= link_to tag.name, short_artist_path(tag.name), class: "tag-type-#{tag.category}" %>
      </div>
      <div class="subscribe-banner-actions">
        <%= render "wiki_pages/subscribe_button", tag: tag, subscription: subscriptions[tag.id] %>
      </div>
    </div>
  <% end %>
</div>
