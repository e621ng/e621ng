<video-player class="video-player">
	<media-container>
		<video playsinline id="image">
			<% post.presenter.initial_video_urls.each do |video| %>
				<%= tag.source(src: video[:url], type: video[:codec]) %>
			<% end %>
		</video>

		<media-controls>
			<media-controls-backdrop class="controls-backdrop"></media-controls-backdrop>
			<media-controls-content class="media-controls">
        <media-play-button class="play-button">
          <media-icon class="play-icon" name="play"></media-icon>
          <media-icon class="pause-icon" name="pause"></media-icon>
        </media-play-button>
        <media-mute-button commandfor="volume-popup"></media-mute-button>
        <media-volume-popover id="volume-popup">
          <media-volume-slider></media-volume-slider>
        </media-volume-popover>
        <media-time-slider>
          <media-slider-track>
            <media-slider-buffer></media-slider-buffer>
            <media-slider-fill></media-slider-fill>
          </media-slider-track>
          <media-slider-thumb></media-slider-thumb>
          <media-slider-preview>
            <media-time-slider-chapter-title></media-time-slider-chapter-title>
            <media-slider-value type="pointer"></media-slider-value>
          </media-slider-preview>
        </media-time-slider>
        <media-time class="time" type="current"></media-time>
      </media-controls-content>
    </media-controls>

    <!-- desktop gestures -->
    <media-gesture type="tap" action="togglePaused" pointer="mouse"></media-gesture>
    <media-gesture type="doubletap" action="toggleFullscreen" region="center" pointer="mouse"></media-gesture>

    <!-- mobile gestures -->
    <media-gesture type="tap" action="togglePaused" pointer="touch"></media-gesture>
    <media-gesture type="doubletap" action="seekStep" value="-10" pointer="touch" region="left"></media-gesture>
    <media-gesture type="doubletap" action="seekStep" value="10" pointer="touch" region="right"></media-gesture>
	</media-container>
</video-player>