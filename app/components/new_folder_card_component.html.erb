<article class="thumbnail favorite-new-folder-card">
  <button type="button" id="favorite-folder-new-trigger" class="favorite-new-folder-card-link" data-parent-id="<%= current_folder_id %>" aria-label="Create a new folder">
    <%= svg_icon(:folder_plus) %>
  </button>
  <div class="thm-desc favorite-new-folder-card-desc">
    <span class="thm-desc-a favorite-new-folder-card-name">
      <span class="favorite-new-folder-card-name-text">New Folder</span>
    </span>
  </div>
</article>
