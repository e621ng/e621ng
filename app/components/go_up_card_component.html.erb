<article class="thumbnail favorite-go-up-card" data-drop-target="go-up" data-destination-folder-id="<%= parent_folder_id %>">
  <a href="<%= favorites_path(folder_id: parent_folder_id) %>" class="thm-link favorite-go-up-card-link" aria-label="Go up one folder level">
    <%= svg_icon(:corner_up_left) %>
  </a>
  <div class="thm-desc favorite-go-up-card-desc">
    <span class="thm-desc-a favorite-go-up-card-name">
      <span class="favorite-go-up-card-name-text">Go Up</span>
    </span>
  </div>
</article>
